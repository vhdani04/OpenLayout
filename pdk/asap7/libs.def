# ASAP7 libraries provided by OpenLayout.
DEFINE asap7_devices     $OPENLAYOUT_HOME/pdk/asap7/xschem/asap7_devices
# 7.5-track standard cells, one library per VT flavor (generated by `setup/install.sh views`)
DEFINE asap7sc7p5t_28_R     $OPENLAYOUT_ROOT/libs/asap7sc7p5t_28_R
DEFINE asap7sc7p5t_28_L     $OPENLAYOUT_ROOT/libs/asap7sc7p5t_28_L
DEFINE asap7sc7p5t_28_SL    $OPENLAYOUT_ROOT/libs/asap7sc7p5t_28_SL
DEFINE asap7sc7p5t_28_SRAM  $OPENLAYOUT_ROOT/libs/asap7sc7p5t_28_SRAM
