+/* Rotation, flip, centring and anchor (*x, *y: the rotated anchor on entry) of symbol text `text`
+ * (string `str`) in an instance with rotation `rot` and flip `flip`. A text with
+ * keep_horizontal=true stays level: where it would run vertically it is drawn horizontally,
+ * centred across the vertical text and starting at its end nearest the anchor. */
+void sym_text_orient(const char *str, xText *text, double xscale, double yscale,
+  short rot, short flip, short *trot, short *tflip, short *hcenter, short *vcenter, double *x, double *y)
+{
+  double x1, y1, x2, y2, dtmp;
+  int tmp;
+  *trot = (text->rot + ( (flip && (text->rot & 1) ) ? rot+2 : rot) ) & 0x3;
+  *tflip = flip ^ text->flip;
+  *hcenter = text->hcenter;
+  *vcenter = text->vcenter;
+  if(!(text->flags & TEXT_KEEP_HORIZONTAL) || !(*trot & 1) || !str) return;
+  text_bbox(str, xscale, yscale, *trot, *tflip, *hcenter, *vcenter, *x, *y, &x1, &y1, &x2, &y2, &tmp, &dtmp);
+  *tflip = 0;
+  *hcenter = 1;
+  *vcenter = 0;
+  /* rot 0: anchor at the top centre, the text below it; rot 2: bottom centre, the text above */
+  if(fabs(*y - y1) <= fabs(*y - y2)) { *trot = 0; *y = y1; }
+  else { *trot = 2; *y = y2; }
+  *x = (x1 + x2) / 2.0;
+}
