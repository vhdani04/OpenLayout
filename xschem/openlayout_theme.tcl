  "#ff8a80" "#bfff81" "#4dd0c4" "#d16ba5" "#d2d46b"
  "#ef6158" "#fdb200"}
set ol_theme(ui) {window #1f2329 panel #262b33 base #181b20 alt #1d2127 border #323843 text #d9dee7 dim #7d8696 accent #4fa3ff select #2c5d94 ok #4cc38a fail #ef6b6b warn #e8b04b}
