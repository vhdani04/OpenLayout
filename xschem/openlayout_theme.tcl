# Widget styling (Tk option database); a no-op without Tk (xschem -x netlisting runs without a display).
proc ol_theme_options {} {
  global ol_theme
  if {[info commands option] eq ""} { return }
  option add *background #262b33 interactive
  option add *foreground #d9dee7 interactive
  option add *activeBackground #323843 interactive
  option add *activeForeground #d9dee7 interactive
  option add *disabledForeground #7d8696 interactive
  option add *disabledBackground #262b33 interactive
  option add *readonlyBackground #1d2127 interactive
  option add *selectBackground #2c5d94 interactive
  option add *selectForeground #ffffff interactive
  option add *inactiveSelectBackground #323843 interactive
  option add *highlightBackground #262b33 interactive
  option add *highlightColor #4fa3ff interactive
  option add *highlightThickness 0 interactive
  option add *troughColor #181b20 interactive
  option add *insertBackground #d9dee7 interactive
  option add *selectColor #181b20 interactive
  option add *Entry.background #181b20 interactive
  option add *Entry.relief flat interactive
  option add *Entry.borderWidth 3 interactive
  option add *Entry.highlightThickness 1 interactive
  option add *Entry.highlightBackground #323843 interactive
  option add *Spinbox.background #181b20 interactive
  option add *Spinbox.relief flat interactive
  option add *Spinbox.buttonBackground #323843 interactive
  option add *Text.background #181b20 interactive
  option add *Text.relief flat interactive
  option add *Text.borderWidth 6 interactive
  option add *Listbox.background #181b20 interactive
  option add *Listbox.relief flat interactive
  option add *Listbox.borderWidth 0 interactive
  option add *Listbox.activeStyle none interactive
  option add *Button.background #323843 interactive
  option add *Button.activeBackground #2c5d94 interactive
  option add *Button.activeForeground #ffffff interactive
  option add *Button.relief flat interactive
  option add *Button.borderWidth 0 interactive
  option add *Button.padX 10 interactive
  option add *Button.padY 3 interactive
  option add *Menubutton.relief flat interactive
  option add *Menubutton.activeBackground #2c5d94 interactive
  option add *Checkbutton.activeBackground #262b33 interactive
  option add *Radiobutton.activeBackground #262b33 interactive
  option add *Menu.background #2c323b interactive
  option add *Menu.activeBackground #2c5d94 interactive
  option add *Menu.activeForeground #ffffff interactive
  option add *Menu.relief flat interactive
  option add *Menu.borderWidth 5 interactive
  option add *Menu.activeBorderWidth 0 interactive
  option add *Menu.selectColor #4fa3ff interactive
  option add *Scrollbar.background #323843 interactive
  option add *Scrollbar.activeBackground #7d8696 interactive
  option add *Scrollbar.troughColor #181b20 interactive
  option add *Scrollbar.relief flat interactive
  option add *Scrollbar.borderWidth 0 interactive
  option add *Scrollbar.elementBorderWidth 0 interactive
  option add *Scrollbar.width 10 interactive
  option add *Panedwindow.sashRelief flat interactive
  option add *Panedwindow.sashWidth 4 interactive
  option add *Panedwindow.background #1f2329 interactive
  option add *Labelframe.foreground #7d8696 interactive
  option add *font $ol_theme(font) interactive
  option add *Text.font $ol_theme(mono) interactive
  option add *Entry.font $ol_theme(font) interactive
  # ttk widgets (xschem's comboboxes)
  if {[info commands ttk::style] ne ""} {
    ttk::style configure TCombobox -fieldbackground #181b20 -background #323843 -foreground #d9dee7 -arrowcolor #d9dee7 -bordercolor #323843 -lightcolor #181b20 -darkcolor #181b20 -selectbackground #2c5d94 -selectforeground #ffffff
    ttk::style map TCombobox -fieldbackground {readonly #181b20} -foreground {readonly #d9dee7}
  }
}
ol_theme_options
