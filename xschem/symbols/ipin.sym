* GPL-2.0-or-later) with a label that stays horizontal however the pin is rotated
* (keep_horizontal, an OpenLayout xschem patch). Shadows devices/ipin.sym on the
* OpenLayout library path.
}
G {}
K {type=ipin
format="*.ipin @lab"
spectre_format="//.ipin @lab"
template="name=p1 lab=xxx"
}
V {}
S {}
F {}
E {}
L 5 -5 0 0 0 {}
B 5 -1.25 -1.25 1.25 1.25 {name=p dir=out}
P 5 7 -5 0 -8.75 -5 -17.5 -5 -13.75 0 -17.5 5 -8.75 5 -5 0 {fill=true}
T {@lab} -18.75 -8.75 0 1 0.33 0.33 {keep_horizontal=true}
T {@spice_get_voltage} 1.875 3.90625 0 0 0.2 0.2 {layer=15}
