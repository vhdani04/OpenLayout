v {xschem version=3.4.8RC file_version=1.3
* OpenLayout ground: the ASAP7 convention names the ground net VSS (like the standard cells and
* the layout's VSS rail), a global net like VDD. OpenLayout's netlisting ties VSS to SPICE's node 0
* for simulation. Shadows xschem's devices/gnd.sym (lab=0) on the OpenLayout library path.
}
G {}
K {type=label
function0="L"
global=true
format="*.alias @lab"
template="name=l1 lab=VSS"}
V {}
S {}
F {}
E {}
L 4 0 0 0 12.5 {}
L 4 -5 12.5 5 12.5 {}
L 4 0 17.5 5 12.5 {}
L 4 -5 12.5 0 17.5 {}
B 5 -2.5 -2.5 2.5 2.5 {name=p dir=inout goto=0}
T {@lab} 7.5 5 0 0 0.2 0.2 {}
