#!/usr/bin/env bash
# openlayout — single entry point for the OpenLayout.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../env/openlayout.sh"

usage() {
  cat <<U
usage: openlayout <command> [args]

  hub [workarea]            start the OpenLayout hub (Library Manager + CIW)
  hubcmd <cmd> <file> ...   send a command to the running hub (used by the tool menus)
  make-symbol <sch> [--force]  generate <cell>.sym from the schematic's pins (Virtuoso style)
  new-workarea <dir> [lib]  create a design workarea (libs.def, xschemrc, sim/, libraries/<lib>)
  new-lib <name>            create a design library in the current workarea
  libs                      list libraries visible from the current workarea
  xschem [args]             start xschem in the current workarea
  klayout [args]            start KLayout (editor mode, ASAP7 technology)
  sim <netlist.sp>          run ngspice in batch mode (BSIM-CMG + ASAP7 cards preloaded)
  maestro [<lib> <cell> | setup.maestro]
                            the simulation environment (tests, variables, corners, vector files,
                            outputs with specs); `maestro run ...` runs it in batch and prints the
                            results table, `maestro new <lib> <cell>` creates a testbench's setup
  viva [file.raw ... | <maestro history dir>]
                            the waveform viewer
  drc <layout.gds> [--cell NAME] [--report FILE]
                            ASAP7 design rule check (KLayout deck from the DRM); prints a summary
                            per rule, results in <layout>.drc.lyrdb (open in KLayout's marker browser)
  lvs <layout.gds> [--cell NAME] [--schematic cell.sch|cell.spice] [--report FILE] [--stdcells check]
                            layout versus schematic (default schematic: <cell>.sch next to the layout;
                            none: the standard-cell CDL); results in <layout>.lvsdb (netlist browser)
  pex <layout.gds> [--cell NAME] [--out FILE] [--mode rc|c] [--rmodel reference|openroad]
      [--schematic cell.sch|cell.spice] [--keep]
                            parasitic extraction: FasterCap 3D field solver capacitances + wire / via
                            resistor networks; a SPICE subcircuit, default <cell>.pex.spice next to
                            the layout (--mode c: capacitances only)
  doctor                    check tools, PDK, models and run the smoke tests
  test                      run the Python unit tests
  env                       print the flow environment
U
}

# Nearest directory at or above $PWD containing libs.def.
find_workarea() {
  local d="$PWD"
  while [ "$d" != / ]; do [ -f "$d/libs.def" ] && { echo "$d"; return 0; }; d="$(dirname "$d")"; done
  return 1
}

# Netlist an xschem schematic as a subcircuit (in its workarea); prints the SPICE file.
netlist_sch() {
  local sch="$1" tmp wa
  tmp="$(mktemp -d)"; wa="$(cd "$(dirname "$sch")" && find_workarea || dirname "$sch")"
  (cd "$wa" && xschem -x -q -r -n -s --tcl "set top_is_subckt 1" -o "$tmp" "$sch" > /dev/null 2>&1) || true
  [ -f "$tmp/$(basename "${sch%.sch}").spice" ] || return 1
  echo "$tmp/$(basename "${sch%.sch}").spice"
}

require_workarea() {
  find_workarea || { echo "openlayout: not inside a workarea (no libs.def found). Use 'openlayout new-workarea <dir>'." >&2; exit 1; }
}

# Print "name<TAB>path" for each library in libs.def, following INCLUDE lines.
list_libs() {
  local file="$1" dir line kw a b
  dir="$(dirname "$file")"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    read -r kw a b <<< "$line" || true
    case "$kw" in
      DEFINE)  b="$(eval echo "$b")"; [[ "$b" = /* ]] || b="$dir/$b"; printf '%s\t%s\n' "$a" "$(readlink -m "$b")" ;;
      INCLUDE) a="$(eval echo "$a")"; [[ "$a" = /* ]] || a="$dir/$a"; [ -f "$a" ] && list_libs "$a" ;;
    esac
  done < "$file"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  new-workarea)
    [ $# -ge 1 ] || { usage; exit 1; }
    wa="$(readlink -m "$1")"; lib="${2:-$(basename "$wa")}"
    [ -e "$wa/libs.def" ] && { echo "openlayout: $wa is already a workarea" >&2; exit 1; }
    mkdir -p "$wa"
    cp -r "$OPENLAYOUT_HOME/templates/workarea/." "$wa/"
    (cd "$wa" && "$0" new-lib "$lib")
    echo "Created workarea $wa with library '$lib'"
    ;;
  new-lib)
    [ $# -eq 1 ] || { usage; exit 1; }
    wa="$(require_workarea)"; name="$1"
    [[ "$name" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]] || { echo "openlayout: invalid library name '$name'" >&2; exit 1; }
    list_libs "$wa/libs.def" | cut -f1 | grep -qx "$name" && { echo "openlayout: library '$name' already defined" >&2; exit 1; }
    mkdir -p "$wa/libraries/$name"
    printf 'DEFINE %-16s libraries/%s\n' "$name" "$name" >> "$wa/libs.def"
    echo "Created library '$name' in $wa/libraries/$name"
    ;;
  libs)
    wa="$(require_workarea)"
    list_libs "$wa/libs.def" | while IFS=$'\t' read -r n p; do
      printf '%-18s %s%s\n' "$n" "$p" "$([ -d "$p" ] || echo '  (missing)')"
    done
    ;;
  xschem)
    wa="$(require_workarea)"; cd "$wa"; exec xschem "$@" ;;
  hub)
    export PYTHONPATH="$OPENLAYOUT_HOME/python${PYTHONPATH:+:$PYTHONPATH}"
    exec "$OPENLAYOUT_ROOT/venv/bin/python" -m openlayout.hub "$@" ;;
  hubcmd)
    PYTHONPATH="$OPENLAYOUT_HOME/python" exec "$OPENLAYOUT_ROOT/venv/bin/python" -m openlayout.cli "$@" ;;
  make-symbol)
    PYTHONPATH="$OPENLAYOUT_HOME/python" exec "$OPENLAYOUT_ROOT/venv/bin/python" -m openlayout.symbolgen "$@" ;;
  test)
    cd "$OPENLAYOUT_HOME"
    PYTHONPATH="$OPENLAYOUT_HOME/python" exec "$OPENLAYOUT_ROOT/venv/bin/python" -m pytest -q tests/python "$@" ;;
  klayout)
    wa="$(find_workarea || true)"; [ -n "$wa" ] && cd "$wa"
    exec klayout -e -n asap7 "$@" ;;
  sim)
    [ $# -ge 1 ] || { usage; exit 1; }
    exec ngspice -b "$@" ;;
  maestro|viva)
    PYTHONPATH="$OPENLAYOUT_HOME/python" exec "$OPENLAYOUT_ROOT/venv/bin/python" -m openlayout.maestro.cli "$cmd" "$@" ;;
  lvs)
    [ $# -ge 1 ] || { usage; exit 1; }
    gds="$(readlink -f "$1")"; shift; cell=""; report=""; sch=""; std=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --cell) cell="$2"; shift 2 ;;
        --schematic) sch="$(readlink -f "$2")"; shift 2 ;;
        --report) report="$2"; shift 2 ;;
        --stdcells) std="$2"; shift 2 ;;
        *) echo "openlayout lvs: unknown option '$1'" >&2; exit 1 ;;
      esac
    done
    [ -f "$gds" ] || { echo "openlayout lvs: no layout file $gds" >&2; exit 1; }
    name="${cell:-$(basename "${gds%.*}")}"
    [ -n "$sch" ] || { [ -f "$(dirname "$gds")/$name.sch" ] && sch="$(dirname "$gds")/$name.sch"; }
    [ -n "$report" ] || report="${gds%.*}${cell:+.$cell}.lvsdb"
    mkdir -p "$(dirname "$report")"
    args=(-rd "input=$gds" -rd "report=$report" -rd "topcell=$name")
    [ -n "$std" ] && args+=(-rd "stdcells=$std")
    if [ -n "$sch" ]; then
      net="$sch"
      if [[ "$sch" == *.sch ]]; then          # netlist the schematic as a subcircuit (xschem, its workarea)
        net="$(netlist_sch "$sch")" || { echo "openlayout lvs: xschem could not netlist $sch" >&2; exit 2; }
      fi
      args+=(-rd "schematic=$net")
      echo "LVS $name: layout $gds, schematic $sch"
    else
      echo "LVS $name: layout $gds, schematic: the standard-cell CDL"
      args+=(-rd stdcells=check)
    fi
    klayout -b -r "$OPENLAYOUT_HOME/pdk/asap7/klayout/lvs/asap7.lvs" "${args[@]}" || { echo "openlayout lvs: the LVS run failed" >&2; exit 2; }
    echo "  results: $report" ;;
  pex)
    [ $# -ge 1 ] || { usage; exit 1; }
    gds="$(readlink -f "$1")"; shift; cell=""; sch=""; args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --cell) cell="$2"; args+=(--cell "$2"); shift 2 ;;
        --schematic) sch="$(readlink -f "$2")"; shift 2 ;;
        --out|--mode|--rmodel) args+=("$1" "$2"); shift 2 ;;
        --keep) args+=(--keep); shift ;;
        *) echo "openlayout pex: unknown option '$1'" >&2; exit 1 ;;
      esac
    done
    [ -f "$gds" ] || { echo "openlayout pex: no layout file $gds" >&2; exit 1; }
    name="${cell:-$(basename "${gds%.*}")}"
    [ -n "$sch" ] || { [ -f "$(dirname "$gds")/$name.sch" ] && sch="$(dirname "$gds")/$name.sch"; }
    if [[ "$sch" == *.sch ]]; then            # the schematic gives the order of the pins
      sch="$(netlist_sch "$sch")" || { echo "openlayout pex: xschem could not netlist the schematic" >&2; exit 2; }
    fi
    [ -n "$sch" ] && args+=(--schematic "$sch")
    PYTHONPATH="$OPENLAYOUT_HOME/python" exec "$OPENLAYOUT_ROOT/venv/bin/python" -m openlayout.pex "$gds" "${args[@]}" ;;
  drc)
    [ $# -ge 1 ] || { usage; exit 1; }
    gds="$(readlink -f "$1")"; shift; cell=""; report=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --cell) cell="$2"; shift 2 ;;
        --report) report="$2"; shift 2 ;;
        *) echo "openlayout drc: unknown option '$1'" >&2; exit 1 ;;
      esac
    done
    [ -f "$gds" ] || { echo "openlayout drc: no layout file $gds" >&2; exit 1; }
    [ -n "$report" ] || report="${gds%.*}${cell:+.$cell}.drc.lyrdb"
    mkdir -p "$(dirname "$report")"
    args=(-rd "input=$gds" -rd "report=$report")
    [ -n "$cell" ] && args+=(-rd "topcell=$cell")
    klayout -b -r "$OPENLAYOUT_HOME/pdk/asap7/klayout/drc/asap7.drc" "${args[@]}" || { echo "openlayout drc: the DRC run failed" >&2; exit 2; }
    exec klayout -b -r "$OPENLAYOUT_HOME/python/openlayout/klayout_scripts/rdb_summary.py" -rd "rdb=$report"       -rd title=DRC -rd "cell=${cell:-$(basename "${gds%.*}")}" ;;
  doctor)
    ok=1
    chk() { if eval "$2" >/dev/null 2>&1; then printf '  [ok]   %s\n' "$1"; else printf '  [FAIL] %s\n' "$1"; ok=0; fi; }
    echo "Tools:"
    echo "  klayout  $(klayout -v 2>/dev/null)"
    echo "  ngspice  $(ngspice -v 2>/dev/null | grep -o 'ngspice-[0-9]*' | head -1)"
    echo "  xschem   $(git -C "$OPENLAYOUT_ROOT/src/xschem" rev-parse --short HEAD 2>/dev/null)"
    echo "  openvaf  $(cat /usr/local/share/openvaf-r.build 2>/dev/null)"
    echo "  FasterCap $(FasterCap -b -h 2>/dev/null | grep -o 'version [0-9.]*' | head -1)"
    echo "PDK & models:"
    chk "ASAP7 PDK"              "[ -d '$ASAP7_PDK/models' ]"
    chk "ASAP7 7.5T std cells"   "[ -n \"\$(ls -A '$ASAP7_STDCELLS')\" ]"
    chk "BSIM-CMG OSDI"          "[ -f '$BSIMCMG_OSDI' ]"
    chk "ASAP7 corner lib"       "[ -f '$ASAP7_SPICE_DIR/asap7.lib' ]"
    chk "~/.spiceinit loads OSDI" "grep -q '^osdi $BSIMCMG_OSDI' ~/.spiceinit"
    echo "KLayout:"
    out="$(klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/check_tech.py" 2>&1 || true)"
    if grep -q "^PASS" <<< "$out"; then printf '  [ok]   ASAP7 technology + std-cell libraries
'
    else printf '  [FAIL] ASAP7 technology + std-cell libraries
'; tail -2 <<< "$out" | sed 's/^/         /'; ok=0; fi
    echo "Schematic-driven layout & editing tools:"
    kl_home="$(mktemp -d)"   # private KLayout profile: never touches the user's settings
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_layoutxl.py" 2>&1 || true)"
    if grep -q "^PASS layoutxl" <<< "$out"; then printf '  [ok]   generate from schematic + connectivity check
'
    else printf '  [FAIL] generate from schematic + connectivity check
'; grep -E "^FAIL|ERROR" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_stdcell.py" 2>&1 || true)"
    if grep -q "^PASS stdcell" <<< "$out"; then printf '  [ok]   standard-cell frame + chaining (matches INVx1 / NAND2xp33)
'
    else printf '  [FAIL] standard-cell frame + chaining
'; grep -E "^FAIL|ERROR" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    for t in path_tool lsw drag_move align stdcell_gui vias generate_form drd; do
      out="$(env -u DISPLAY QT_QPA_PLATFORM=offscreen HOME="$kl_home" klayout -e -z -nc -r "$OPENLAYOUT_HOME/tests/klayout/test_$t.py" 2>&1 || true)"
      if grep -q "^PASS $t" <<< "$out"; then printf '  [ok]   %s
' "$t"
      else printf '  [FAIL] %s
' "$t"; grep -E "^FAIL|ERROR" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    done
    echo "Design rule check (ASAP7 deck):"
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_drc.py" 2>&1 || true)"
    if grep -q "^PASS drc" <<< "$out"; then printf '  [ok]   every rule fires on its seeded violation; references and generators clean
'
    else printf '  [FAIL] DRC rules
'; grep -E "^FAIL|ERROR" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_drc_library.py" 2>&1 || true)"
    if grep -q "^PASS drc_library" <<< "$out"; then printf '  [ok]   all 7.5T RVT library cells DRC-clean in context
'
    else printf '  [FAIL] library cells in context
'; grep -E "^FAIL|ERROR" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    out="$(env -u DISPLAY QT_QPA_PLATFORM=offscreen HOME="$kl_home" klayout -e -z -nc -r "$OPENLAYOUT_HOME/tests/klayout/test_drc_gui.py" 2>&1 || true)"
    if grep -q "^PASS drc_gui" <<< "$out"; then printf '  [ok]   Run DRC in KLayout, results in the marker browser
'
    else printf '  [FAIL] Run DRC in KLayout
'; grep -E "^FAIL|ERROR" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    echo "Layout versus schematic (ASAP7 deck):"
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_lvs.py" 2>&1 || true)"
    if grep -q "^PASS lvs$" <<< "$out"; then printf '  [ok]   matches, fins / VT / bulk / opens / shorts / pin swaps caught, fingers, PCells
'
    else printf '  [FAIL] LVS cases
'; grep -E "^FAIL|ERROR" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    out="$(cd /tmp && HOME="$kl_home" klayout -b -r "$OPENLAYOUT_HOME/tests/klayout/test_lvs_library.py" 2>&1 || true)"
    if grep -q "^PASS lvs_library" <<< "$out"; then printf '  [ok]   all 7.5T RVT library cells against their CDL
'
    else printf '  [FAIL] library cells against their CDL
'; grep -E "^FAIL|ERROR" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    out="$(env -u DISPLAY QT_QPA_PLATFORM=offscreen HOME="$kl_home" klayout -e -z -nc -r "$OPENLAYOUT_HOME/tests/klayout/test_lvs_gui.py" 2>&1 || true)"
    if grep -q "^PASS lvs_gui" <<< "$out"; then printf '  [ok]   Run LVS in KLayout (xschem schematic), results in the netlist browser
'
    else printf '  [FAIL] Run LVS in KLayout
'; grep -E "^FAIL|ERROR" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    rm -rf "$kl_home"
    echo "Parasitic extraction:"
    out="$(cd /tmp && PYTHONPATH="$OPENLAYOUT_HOME/python" timeout 900 "$OPENLAYOUT_ROOT/venv/bin/python" "$OPENLAYOUT_HOME/tests/pex/test_pex.py" 2>&1 || true)"
    if grep -q "^PASS pex" <<< "$out"; then printf '  [ok]   FasterCap capacitances vs the library reference, R networks, hierarchy, post-layout sim
'
    else printf '  [FAIL] parasitic extraction
'; grep -E "^FAIL|rror" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    echo "Simulation environment (Maestro, waveform viewer):"
    out="$(cd "$OPENLAYOUT_HOME" && PYTHONPATH="$OPENLAYOUT_HOME/python" QT_QPA_PLATFORM=offscreen timeout 900 "$OPENLAYOUT_ROOT/venv/bin/python" -m pytest -q -p no:cacheprovider tests/python/test_maestro.py tests/python/test_maestro_gui.py 2>&1 || true)"
    last="$(tail -1 <<< "$out")"
    if grep -q "passed" <<< "$last" && ! grep -qE "failed|error" <<< "$last"; then printf '  [ok]   corners / sweeps / vector files / specs / post-layout, results table, plots, cursors (%s)\n' "${last%% in *}"
    else printf '  [FAIL] Maestro\n'; grep -E "^FAILED|Error" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
    echo "xschem netlist + simulate:"
    tmp="$(mktemp -d)"
    mkdir -p "$tmp/home"   # xschem writes ~/.xschem: keep the user's untouched
    "$0" new-workarea "$tmp/wa" doctor > /dev/null
    for sch in "$OPENLAYOUT_HOME"/tests/xschem/*/*.sch; do
      name="$(basename "$sch" .sch)"
      (cd "$tmp/wa" && HOME="$tmp/home" xschem -x -q -r -n -s -o "$tmp/net" "$sch" > /dev/null 2>&1 || true)
      out="$( [ -f "$tmp/net/$name.spice" ] && cd "$tmp/net" && ngspice -b "$name.spice" 2>&1 || echo "FAIL no netlist")"
      if grep -q "^PASS" <<< "$out"; then printf '  [ok]   %s
' "$name"
      else printf '  [FAIL] %s
' "$name"; grep -E "FAIL|rror" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    done
    rm -rf "$tmp"
    echo "xschem (hub link and editing):"
    if command -v xvfb-run > /dev/null; then
      xs_home="$(mktemp -d)"; xs_wa="$(mktemp -d)/wa"; "$0" new-workarea "$xs_wa" doctor > /dev/null
      port=$(python3 -c "import socket; s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1])")
      out="$(cd "$xs_wa" && HOME="$xs_home" xvfb-run -a sh -c "xschem --tcl 'set xschem_listen_port $port' > /dev/null 2>&1 & sleep 4; python3 '$OPENLAYOUT_HOME/tests/xschem_server_stress.py' $port; kill %1" 2>&1 || true)"
      if grep -q "^PASS xschem server" <<< "$out"; then printf '  [ok]   survives overlapping and abandoned requests
'
      else printf '  [FAIL] xschem command server
'; grep -E "FAIL|Error" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
      # Editing: property form, pin dialog, symbol border, context keys (in a fresh workarea cell)
      mkdir -p "$xs_wa/libraries/doctor/inv"
      cp "$OPENLAYOUT_HOME/tests/klayout/inv_pins.sch" "$xs_wa/libraries/doctor/inv/inv.sch"
      PYTHONPATH="$OPENLAYOUT_HOME/python" "$OPENLAYOUT_ROOT/venv/bin/python" -c "
from openlayout.workarea import Workarea, SYMBOL
wa = Workarea('$xs_wa'); wa.new_view(wa.library('doctor'), 'box', SYMBOL)"
      out="$(cd "$xs_wa" && HOME="$xs_home" xvfb-run -a sh -c "xschem --tcl 'set xschem_listen_port $port' > /dev/null 2>&1 & sleep 4; OL_TEST_LIB=doctor python3 '$OPENLAYOUT_HOME/tests/xschem_edit_test.py' $port '$xs_wa'; kill %1" 2>&1 || true)"
      if grep -q "^PASS xschem edit" <<< "$out"; then printf '  [ok]   property form, pin dialog, symbol border, edge stretch, context keys
'
      else printf '  [FAIL] xschem editing
'; grep -E "^FAIL|Error" <<< "$out" | head -4 | sed 's/^/         /'; ok=0; fi
      rm -rf "$xs_home" "$(dirname "$xs_wa")"
    else
      printf '  [skip] xvfb-run not installed
'
    fi
    echo "Smoke tests:"
    for t in "$OPENLAYOUT_HOME"/tests/sim/*.sp; do
      out="$(cd "$(dirname "$t")" && ngspice -b "$t" 2>&1 || true)"
      if grep -q "^PASS" <<< "$out"; then printf '  [ok]   %s\n' "$(basename "$t")"
      else printf '  [FAIL] %s\n' "$(basename "$t")"; grep -E "FAIL|rror" <<< "$out" | head -3 | sed 's/^/         /'; ok=0; fi
    done
    [ $ok = 1 ] && echo "All good." || { echo "Problems found."; exit 1; }
    ;;
  env)
    env | grep -E '^(OPENLAYOUT_|PDK|ASAP7_|BSIMCMG_)' | sort ;;
  help|-h|--help) usage ;;
  *) echo "openlayout: unknown command '$cmd'" >&2; usage; exit 1 ;;
esac
